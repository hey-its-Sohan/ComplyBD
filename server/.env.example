# ---------------------------------------------------------------------------
# ComplyBD server configuration
# Copy to .env and adjust. Every value below has a working default, so the app
# runs with no .env file at all.
# ---------------------------------------------------------------------------

PORT=5000
JWT_SECRET=complybd-hackathon-secret

# Optional. If MongoDB is not reachable the server starts an in-memory database
# and seeds it automatically, so the demo always runs.
MONGO_URI=mongodb://127.0.0.1:27017/complybd

# ---------------------------------------------------------------------------
# Extraction engine
# ---------------------------------------------------------------------------
# Which provider to use: openai | anthropic | demo
#
# If the chosen provider has no API key, ComplyBD falls back to the built-in
# deterministic demo engine. The full pipeline — extraction, grounding,
# confidence, review routing — works either way. The grounding layer is
# deterministic and never calls a model, so the safety behaviour is identical.
AI_PROVIDER=openai

# Leave blank to run on the demo engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative provider, enabled with AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Milliseconds before an LLM request is abandoned and the demo engine takes over.
AI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Blockchain anchoring
# ---------------------------------------------------------------------------
# The audit trail is hash-chained regardless of these settings. Anchoring
# publishes one digest so tampering stays detectable even if the database is
# rewritten. Only a 32-byte hash is ever sent — never business or client data.
#
# Leave blank for demo mode: anchors are deterministically derived from the
# audit hash and are labelled "Prototype blockchain anchor" in the UI.
#
# To anchor on a real testnet, set both values below and `npm i ethers`.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_TIMEOUT_MS=20000

# Periodic anchoring for unattended deployments, in milliseconds.
# Leave at 0 (the default) for demos: automatic anchors would append an audit
# record every interval and pre-empt the manual "Create blockchain anchor"
# action. Anchoring is always available from the UI regardless of this setting.
AUTO_ANCHOR_INTERVAL_MS=0
